  },
  "dimensiones": {
    "politico": "Polidades, dinastías, imperios, colonias.",
    "historico": "Hechos públicos datados (guerras, tratados, eventos).",
    "religioso": "Sistemas de sentido sacralizado (émico + instituciones).",
    "cientifico": "Datación, técnica, clima, especie.",
    "cultural": "Formas: lengua, canon, estilo, escuela.",
    "social": "Trabajo, género, casta, imperio-como-sociedad, demografía."
