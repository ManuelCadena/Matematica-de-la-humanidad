  "consultas": {
    "fibra_egipto_religiosa": "civilizaciones_fibras.json → egypt.fibers.religioso",
    "acoples_sahel": "[e for e in acoples if 'sahel' in (e['from'], e['to'])]",
    "corte_800": "nodos con start<=800<=end en ontologia + lentes"
  }
